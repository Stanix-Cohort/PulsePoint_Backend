// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//=====================================================

enum Role {
  DONOR
  HOSPITAL
  ADMIN
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum RequestUrgency {
  CRITICAL
  URGENT
  ROUTINE
}

enum RequestStatus {
  OPEN
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
}

enum ResponseStatus {
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum DonationOutcome {
  DONATED
  NO_SHOW
}

enum NotificationType {
  NEW_BLOOD_REQUEST
  RESPONSE_ACCEPTED
  RESPONSE_WITHDRAWN
  DONATION_CONFIRMED
  REQUEST_CANCELLED
}

enum Gender {
  MALE
  FEMALE
}

//=====================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donor              Donor?
  hospital           Hospital?
  donationsConfirmed Donation[]

  @@map("users")
}

//=====================================================

model Donor {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  bloodType   BloodType
  dateOfBirth DateTime  @db.Date

  gender Gender

  phoneNumber String
  address     String
  state       String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notifications Notification[]

  user      User              @relation(fields: [userId], references: [id])
  donations Donation[]
  responses RequestResponse[]

  @@map("donors")
}

//=====================================================

model Hospital {
  id           String  @id @default(uuid())
  userId       String  @unique
  hospitalName String
  licenseId    String  @unique
  phoneNumber  String
  state        String
  address      String
  logoUrl      String?

  contactName  String
  contactPhone String
  contactRole  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  user     User           @relation(fields: [userId], references: [id])
  requests BloodRequest[]

  @@map("hospitals")
}

//=====================================================

model BloodRequest {
  id             String         @id @default(uuid())
  hospitalId     String
  bloodType      BloodType
  unitsRequired  Int
  unitsFulfilled Int            @default(0)
  notes          String?
  urgencyLevel   RequestUrgency
  status         RequestStatus  @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  notifications Notification[]

  hospital  Hospital          @relation(fields: [hospitalId], references: [id])
  donations Donation[]
  responses RequestResponse[]

  @@map("bloodRequests")
}

//=====================================================

model RequestResponse {
  id        String         @id @default(uuid())
  requestId String
  donorId   String
  status    ResponseStatus
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  request  BloodRequest @relation(fields: [requestId], references: [id])
  donor    Donor        @relation(fields: [donorId], references: [id])
  donation Donation?

  @@unique([requestId, donorId])
  @@map("responses")
}

//=====================================================

model Donation {
  id                String          @id @default(uuid())
  requestId         String
  donorId           String
  responseId        String          @unique
  units             Int?
  notes             String?
  donationOutcome   DonationOutcome
  confirmedById     String
  outcomeRecordedAt DateTime        @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request     BloodRequest    @relation(fields: [requestId], references: [id])
  donor       Donor           @relation(fields: [donorId], references: [id])
  response    RequestResponse @relation(fields: [responseId], references: [id])
  confirmedBy User            @relation(fields: [confirmedById], references: [id])

  @@map("donations")
}

//=======================================================

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)

  // Target Recipients (One will be populated based on type)
  donorId    String?
  hospitalId String?

  // Optional reference link
  requestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donor    Donor?        @relation(fields: [donorId], references: [id], onDelete: Cascade)
  hospital Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  request  BloodRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([donorId])
  @@index([hospitalId])
  @@index([requestId])
  @@map("notifications")
}

//=====================================================

// User
// ├── 0..1 Donor
// ├── 0..1 Hospital
// └── many DonationsConfirmed

// Hospital
// └── many BloodRequests

// Donor
// ├── many RequestResponses
// └── many Donations

// BloodRequest
// ├── many RequestResponses
// └── many Donations

// RequestResponse
// └── 0..1 Donation

// Donation
// ├── exactly 1 BloodRequest
// ├── exactly 1 Donor
// ├── exactly 1 RequestResponse
// └── exactly 1 confirming User
